# ~/timetable.gulistanps.uz/app/backend/.env  (git'ga kirmaydi)
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DJANGO_ALLOWED_HOSTS=timetable.gulistanps.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://timetable.gulistanps.uz
DJANGO_SECURE_COOKIES=1
# Django admin CSS/JS domen papkasiga yig'iladi — Apache o'zi beradi
DJANGO_STATIC_ROOT=/home/gulistanps/timetable.gulistanps.uz/static

# Ma'lumotlar bazasi: cPanel → PostgreSQL Databases da yaratilgan baza va foydalanuvchi
# (cPanel nomlarga prefiks qo'shadi: gulistanps_...). Talab: PostgreSQL 15+.
# Bu qatorlarni o'chirsangiz — SQLite.
DJANGO_DB_ENGINE=postgresql
DB_NAME=gulistanps_timetable
DB_USER=gulistanps_timetable
DB_PASSWORD=baza-paroli
DB_HOST=localhost
DB_PORT=5432
