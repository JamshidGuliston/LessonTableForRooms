# /srv/darsjadval/backend/.env  (git'ga kirmaydi). Nusxa olib, qiymatlarni o'zgartiring.
DJANGO_DEBUG=0
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
# Domen va/yoki server IP (planshetlar IP orqali ulansa, IP ni ham yozing)
DJANGO_ALLOWED_HOSTS=jadval.example.uz,192.168.1.10
DJANGO_CSRF_TRUSTED_ORIGINS=https://jadval.example.uz
# HTTPS bo'lmasa (faqat http://IP) 0 qiling, aks holda /admin/ ga kirib bo'lmaydi
DJANGO_SECURE_COOKIES=1
